# ============================================================================
# PartyClassRegistros — Frontend
# Copia este archivo a `.env` y completa los valores.
# Todo lo que empieza por VITE_ queda visible en el bundle del navegador.
# ============================================================================

# URL base de la API REST del backend
VITE_API_URL=http://localhost:4000/api/v1

# Debe coincidir exactamente con API_KEY del backend.
# Ojo: al ser una app interna sin login, esta clave es visible en el cliente.
# Su función es impedir el acceso anónimo desde fuera de la red, no autenticar
# usuarios. Mantén el backend restringido por red o por IP.
VITE_API_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

# Nombre visible de la aplicación
VITE_APP_NAME=PartyClass
